Options -Indexes
DirectoryIndex index.html index.php

# Keep legacy redirects
Redirect 301 /all-games.html /all-yono-games.html
Redirect 301 /privacy.html /privacy-policy.html

# Block hidden files, but allow the .well-known directory
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
